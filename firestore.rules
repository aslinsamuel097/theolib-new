rules_version = '2';

/**
 * THEOLIB PERMANENT SECURITY RULES
 * --------------------------------
 * This configuration removes the 30-day "Test Mode" restriction.
 * Access is now governed by explicit definitions rather than an expiry date.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Explicit rules for the unified protocol system
    match /messages/{messageId} {
      allow read, write: if true; // Permissive for theological sanctuary development
    }

    // Globally permissive rules for the sanctuary during development
    // This allows the app to function without timestamp-based blocking
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
